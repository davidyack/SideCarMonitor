<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="SideCarMonitor.Controls.CameraTile"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vlc="using:LibVLCSharp.Platforms.Windows">

    <Grid x:Name="Frame" Background="Black" CornerRadius="{StaticResource Corner}"
          BorderThickness="{StaticResource TileBorder}" BorderBrush="{StaticResource PanelBorder}">

        <vlc:VideoView x:Name="Video" Initialized="Video_Initialized" />

        <!-- Connection overlay -->
        <StackPanel x:Name="Overlay" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Spacing="{StaticResource Gap}" Margin="{StaticResource LabelMargin}">
            <ProgressRing x:Name="Spinner" IsActive="True"
                          Width="{StaticResource Spinner}" Height="{StaticResource Spinner}" />
            <TextBlock x:Name="OverlayText" Text="Connecting" HorizontalAlignment="Center"
                       FontSize="{StaticResource FontCaption}" Foreground="{StaticResource MutedText}"
                       TextWrapping="Wrap" TextAlignment="Center" />
        </StackPanel>

        <!-- Name label -->
        <Border VerticalAlignment="Top" HorizontalAlignment="Left" Margin="{StaticResource LabelMargin}"
                Padding="{StaticResource LabelPadding}" CornerRadius="{StaticResource SmallCorner}" Background="#99000000">
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource Gap}">
                <Ellipse x:Name="LiveDot" Width="{StaticResource Dot}" Height="{StaticResource Dot}"
                         Fill="{StaticResource MutedText}" VerticalAlignment="Center" />
                <TextBlock x:Name="NameText" FontSize="{StaticResource FontCaption}" FontWeight="SemiBold" />
            </StackPanel>
        </Border>

        <!-- Detection badge -->
        <Border x:Name="DetectionBadge" Visibility="Collapsed" VerticalAlignment="Top" HorizontalAlignment="Right"
                Margin="{StaticResource LabelMargin}" Padding="{StaticResource LabelPadding}"
                CornerRadius="{StaticResource SmallCorner}" Background="{StaticResource AlertBrush}">
            <TextBlock x:Name="DetectionText" FontSize="{StaticResource FontCaption}" FontWeight="Bold" Foreground="White" />
        </Border>

        <!-- API (motion) error -->
        <Border x:Name="ApiErrorBadge" Visibility="Collapsed" VerticalAlignment="Bottom" HorizontalAlignment="Right"
                Margin="{StaticResource LabelMargin}" Padding="{StaticResource LabelPadding}"
                CornerRadius="{StaticResource SmallCorner}" Background="#99000000">
            <TextBlock x:Name="ApiErrorText" FontSize="{StaticResource FontCaption}" Foreground="#FFB86B" />
        </Border>
    </Grid>
</UserControl>
