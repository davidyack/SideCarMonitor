<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="SideCarMonitor.Controls.TasksPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="{StaticResource KioskBackground}" Padding="{StaticResource PagePadding}" RowSpacing="{StaticResource Gap}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid ColumnSpacing="{StaticResource Gap}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Click="Home_Click" Height="{StaticResource TouchTarget}" Padding="{StaticResource PanelPadding}"
                    CornerRadius="{StaticResource SmallCorner}" FontSize="{StaticResource FontBody}" AutomationProperties.Name="Home">
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource Gap}">
                    <FontIcon Glyph="&#xE80F;" FontSize="{StaticResource FontIcon}" />
                    <TextBlock Text="Home" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="To-do" FontSize="{StaticResource FontTitle}" FontWeight="SemiBold" />
                <TextBlock x:Name="SubtitleText" FontSize="{StaticResource FontCaption}" Foreground="{StaticResource MutedText}" />
            </StackPanel>
            <Grid Grid.Column="2" ColumnSpacing="{StaticResource SmallGap}" Width="{StaticResource AssistantWidth}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="NewTaskBox" PlaceholderText="Add a task" FontSize="{StaticResource FontBody}"
                         MinHeight="{StaticResource TouchTarget}" VerticalContentAlignment="Center" KeyDown="NewTaskBox_KeyDown" />
                <Button Grid.Column="1" Click="AddTask_Click" Width="{StaticResource TouchTarget}" Height="{StaticResource TouchTarget}"
                        Padding="0" CornerRadius="{StaticResource SmallCorner}" Background="{StaticResource TileEmerald}"
                        Foreground="White" AutomationProperties.Name="Add task">
                    <FontIcon Glyph="&#xE710;" FontSize="{StaticResource FontIcon}" />
                </Button>
            </Grid>
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="{StaticResource Gap}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5*" />
                <ColumnDefinition Width="7*" />
            </Grid.ColumnDefinitions>

            <!-- Left: views + list -->
            <Grid RowSpacing="{StaticResource SmallGap}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid x:Name="Tabs" ColumnSpacing="{StaticResource SmallGap}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="TabToday" Tag="Today" Click="Tab_Click" HorizontalAlignment="Stretch" Height="{StaticResource TouchTarget}"
                            CornerRadius="{StaticResource SmallCorner}" FontSize="{StaticResource FontCaption}" />
                    <Button x:Name="TabUpcoming" Grid.Column="1" Tag="Upcoming" Click="Tab_Click" HorizontalAlignment="Stretch"
                            Height="{StaticResource TouchTarget}" CornerRadius="{StaticResource SmallCorner}" FontSize="{StaticResource FontCaption}" />
                    <Button x:Name="TabNeedsMe" Grid.Column="2" Tag="NeedsMe" Click="Tab_Click" HorizontalAlignment="Stretch"
                            Height="{StaticResource TouchTarget}" CornerRadius="{StaticResource SmallCorner}" FontSize="{StaticResource FontCaption}" />
                    <Button x:Name="TabDone" Grid.Column="3" Tag="Done" Click="Tab_Click" HorizontalAlignment="Stretch"
                            Height="{StaticResource TouchTarget}" CornerRadius="{StaticResource SmallCorner}" FontSize="{StaticResource FontCaption}" />
                </Grid>

                <!-- Daily brief -->
                <Border x:Name="BriefCard" Grid.Row="1" Visibility="Collapsed" Background="{StaticResource PanelBackground}"
                        BorderBrush="{StaticResource TileAmber}" BorderThickness="2" CornerRadius="{StaticResource SmallCorner}"
                        Padding="{StaticResource LabelPadding}">
                    <Grid ColumnSpacing="{StaticResource Gap}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Today's brief" FontSize="{StaticResource FontCaption}" FontWeight="SemiBold" Foreground="{StaticResource TileAmber}" />
                            <TextBlock x:Name="BriefText" FontSize="{StaticResource FontCaption}" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Grid.Column="1" Click="DismissBrief_Click" Width="{StaticResource TouchTarget}" Height="{StaticResource TouchTarget}"
                                Padding="0" VerticalAlignment="Top" CornerRadius="{StaticResource SmallCorner}" AutomationProperties.Name="Dismiss brief">
                            <FontIcon Glyph="&#xE711;" FontSize="{StaticResource FontIcon}" />
                        </Button>
                    </Grid>
                </Border>

                <ListView x:Name="TaskList" Grid.Row="2" SelectionMode="Single" SelectionChanged="TaskList_SelectionChanged">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="MinHeight" Value="{StaticResource ActivityRowHeight}" />
                            <Setter Property="Padding" Value="{StaticResource RowPadding}" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListView.ItemContainerStyle>
                </ListView>
                <TextBlock x:Name="EmptyText" Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontSize="{StaticResource FontCaption}" Foreground="{StaticResource MutedText}" />
            </Grid>

            <!-- Right: task detail -->
            <Border Grid.Column="1" Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource PanelBorder}"
                    BorderThickness="1" CornerRadius="{StaticResource Corner}">
                <Grid>
                    <TextBlock x:Name="NoSelectionText" Text="Pick a task, or add one above." HorizontalAlignment="Center"
                               VerticalAlignment="Center" FontSize="{StaticResource FontBody}" Foreground="{StaticResource MutedText}" />
                    <ScrollViewer x:Name="DetailScroll" Visibility="Collapsed" Padding="{StaticResource PanelPadding}">
                        <StackPanel x:Name="Detail" Spacing="{StaticResource Gap}" />
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
