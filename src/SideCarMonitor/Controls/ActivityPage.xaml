<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="SideCarMonitor.Controls.ActivityPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:SideCarMonitor.Models">

    <Grid Background="{StaticResource KioskBackground}" Padding="{StaticResource PagePadding}" RowSpacing="{StaticResource Gap}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header: Home, title, filters -->
        <Grid ColumnSpacing="{StaticResource Gap}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Click="Home_Click" Height="{StaticResource TouchTarget}" Padding="{StaticResource PanelPadding}"
                    CornerRadius="{StaticResource SmallCorner}" FontSize="{StaticResource FontBody}" AutomationProperties.Name="Home">
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource Gap}">
                    <FontIcon Glyph="&#xE80F;" FontSize="{StaticResource FontIcon}" />
                    <TextBlock Text="Home" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="Activity" FontSize="{StaticResource FontTitle}" FontWeight="SemiBold" />
                <TextBlock x:Name="SubtitleText" FontSize="{StaticResource FontCaption}" Foreground="{StaticResource MutedText}" />
            </StackPanel>
            <StackPanel x:Name="Filters" Grid.Column="2" Orientation="Horizontal" Spacing="{StaticResource SmallGap}">
                <Button x:Name="ClearButton" Tag="-" Content="Clear" Click="Clear_Click" FontSize="{StaticResource FontBody}" Height="{StaticResource TouchTarget}"
                        Padding="{StaticResource PanelPadding}" Background="{StaticResource TileCrimson}" Foreground="White" />
                <Button x:Name="HistoryButton" Tag="-" Content="History" Click="History_Click" FontSize="{StaticResource FontBody}" Height="{StaticResource TouchTarget}"
                        Padding="{StaticResource PanelPadding}" Margin="0,0,16,0" />
                <Button Tag="all" Content="All" Click="Filter_Click" FontSize="{StaticResource FontBody}" Height="{StaticResource TouchTarget}" Padding="{StaticResource PanelPadding}" />
                <Button Tag="camera" Content="Cameras" Click="Filter_Click" FontSize="{StaticResource FontBody}" Height="{StaticResource TouchTarget}" Padding="{StaticResource PanelPadding}" />
                <Button Tag="door" Content="Doors" Click="Filter_Click" FontSize="{StaticResource FontBody}" Height="{StaticResource TouchTarget}" Padding="{StaticResource PanelPadding}" />
                <Button Tag="house" Content="House" Click="Filter_Click" FontSize="{StaticResource FontBody}" Height="{StaticResource TouchTarget}" Padding="{StaticResource PanelPadding}" />
                <Button Tag="weather" Content="Weather" Click="Filter_Click" FontSize="{StaticResource FontBody}" Height="{StaticResource TouchTarget}" Padding="{StaticResource PanelPadding}" />
                <Button Tag="system" Content="System" Click="Filter_Click" FontSize="{StaticResource FontBody}" Height="{StaticResource TouchTarget}" Padding="{StaticResource PanelPadding}" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="{StaticResource Gap}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Feed -->
            <Border Background="{StaticResource PanelBackground}" CornerRadius="{StaticResource Corner}">
                <Grid>
                    <ListView x:Name="FeedList" SelectionMode="Single" IsItemClickEnabled="True" ItemClick="FeedList_ItemClick">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Padding" Value="{StaticResource RowPadding}" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:MotionEvent">
                                <Grid ColumnSpacing="{StaticResource Gap}" Padding="0,6,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="{x:Bind Glyph, Mode=OneWay}" FontSize="{StaticResource FontIcon}" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock FontSize="{StaticResource FontBody}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis">
                                            <Run Text="{x:Bind Label, Mode=OneWay}" />
                                            <Run Text="&#x00B7;" Foreground="{StaticResource MutedText}" />
                                            <Run Text="{x:Bind CameraName}" />
                                        </TextBlock>
                                        <TextBlock FontSize="{StaticResource FontCaption}" Foreground="{StaticResource MutedText}">
                                            <Run Text="{x:Bind TimeText}" />
                                            <Run Text="&#x00B7;" />
                                            <Run Text="{x:Bind DurationText, Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBlock Text="{x:Bind VerdictText, Mode=OneWay}" FontSize="{StaticResource FontCaption}"
                                                   Foreground="{StaticResource AccentText}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <Image Grid.Column="2" Source="{x:Bind Thumbnail, Mode=OneWay}" Visibility="{x:Bind HasThumbnail, Mode=OneWay}"
                                           Stretch="UniformToFill" Height="{StaticResource ActivityThumbHeight}" Width="{StaticResource ActivityThumbWidth}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock x:Name="EmptyText" Text="Nothing here yet" Visibility="Collapsed" HorizontalAlignment="Center"
                               VerticalAlignment="Center" FontSize="{StaticResource FontBody}" Foreground="{StaticResource MutedText}" />
                </Grid>
            </Border>

            <!-- Detail of the tapped event -->
            <Border Grid.Column="1" Background="{StaticResource PanelBackground}" CornerRadius="{StaticResource Corner}" Padding="{StaticResource PanelPadding}">
                <Grid>
                    <TextBlock x:Name="PickText" Text="Tap an event to see it" HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontSize="{StaticResource FontBody}" Foreground="{StaticResource MutedText}" />
                    <ScrollViewer x:Name="DetailScroll" Visibility="Collapsed">
                        <StackPanel Spacing="{StaticResource Gap}">
                            <TextBlock x:Name="DetailTitle" FontSize="{StaticResource FontTitle}" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock x:Name="DetailWhen" FontSize="{StaticResource FontBody}" Foreground="{StaticResource MutedText}" TextWrapping="Wrap" />
                            <TextBlock x:Name="DetailAi" FontSize="{StaticResource FontBody}" Foreground="{StaticResource AccentText}" TextWrapping="Wrap" />
                            <StackPanel x:Name="DetailPictures" Spacing="{StaticResource SmallGap}" />
                            <Button x:Name="WatchLiveButton" Click="WatchLive_Click" HorizontalAlignment="Left" FontSize="{StaticResource FontBody}"
                                    Height="{StaticResource TouchTarget}" Padding="{StaticResource PanelPadding}"
                                    Background="{StaticResource TileCobalt}" Foreground="White" CornerRadius="{StaticResource SmallCorner}">
                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource Gap}">
                                    <FontIcon Glyph="&#xE714;" FontSize="{StaticResource FontIcon}" />
                                    <TextBlock Text="Watch live" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
