<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="SideCarMonitor.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:SideCarMonitor.Models"
    xmlns:controls="using:SideCarMonitor.Controls"
    Title="SideCar Monitor">

    <!-- All sizes are StaticResources scaled by display.uiScale (see UiScale.cs); this is a small touchscreen.
         Both pages live in the same cell. The camera page stays loaded underneath Home so the streams keep
         running and opening Cameras is instant. -->
    <Grid x:Name="Root" Background="{StaticResource KioskBackground}" KeyboardAcceleratorPlacementMode="Hidden">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="Q" Modifiers="Control" Invoked="Quit_Invoked" />
            <KeyboardAccelerator Key="F11" Invoked="ToggleFullScreen_Invoked" />
            <KeyboardAccelerator Key="Escape" Invoked="Escape_Invoked" />
        </Grid.KeyboardAccelerators>

        <!-- ===================== Cameras page ===================== -->
        <Grid x:Name="CamerasPage" Padding="{StaticResource PagePadding}" RowSpacing="{StaticResource Gap}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid ColumnSpacing="{StaticResource Gap}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Click="HomeButton_Click" Height="{StaticResource TouchTarget}" Padding="{StaticResource PanelPadding}"
                        CornerRadius="{StaticResource SmallCorner}" FontSize="{StaticResource FontBody}"
                        AutomationProperties.Name="Home">
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource Gap}">
                        <FontIcon Glyph="&#xE80F;" FontSize="{StaticResource FontIcon}" />
                        <TextBlock Text="Home" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Cameras" FontSize="{StaticResource FontTitle}" FontWeight="SemiBold" />
                    <TextBlock x:Name="StatusText" FontSize="{StaticResource FontCaption}"
                               Foreground="{StaticResource MutedText}" />
                </StackPanel>
                <TextBlock x:Name="CamerasClockText" Grid.Column="2" FontSize="{StaticResource FontTitle}"
                           VerticalAlignment="Center" />
            </Grid>

            <Grid Grid.Row="1" ColumnSpacing="{StaticResource Gap}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="{StaticResource ActivityWidth}" />
                </Grid.ColumnDefinitions>

                <Grid x:Name="CameraGrid" SizeChanged="CameraGrid_SizeChanged" />

                <!-- Shown while one camera fills the area -->
                <Button x:Name="BackButton" Visibility="Collapsed" Click="BackButton_Click"
                        VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="{StaticResource LabelMargin}"
                        Height="{StaticResource TouchTarget}" Padding="{StaticResource PanelPadding}"
                        CornerRadius="{StaticResource SmallCorner}" Background="#CC14181D"
                        FontSize="{StaticResource FontBody}">
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource Gap}">
                        <FontIcon Glyph="&#xE80A;" FontSize="{StaticResource FontIcon}" />
                        <TextBlock Text="All cameras" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <StackPanel x:Name="EmptyState" Visibility="Collapsed" VerticalAlignment="Center"
                            HorizontalAlignment="Center" Spacing="{StaticResource Gap}">
                    <FontIcon Glyph="&#xE714;" FontSize="{StaticResource FontClock}" Foreground="{StaticResource MutedText}" />
                    <TextBlock Text="No cameras configured" FontSize="{StaticResource FontTitle}" HorizontalAlignment="Center" />
                    <TextBlock x:Name="EmptyStateDetail" TextWrapping="Wrap" TextAlignment="Center"
                               FontSize="{StaticResource FontCaption}" Foreground="{StaticResource MutedText}" />
                </StackPanel>

                <!-- Activity panel -->
                <Border Grid.Column="1" Background="{StaticResource PanelBackground}"
                        BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="{StaticResource Corner}">
                    <Grid RowSpacing="{StaticResource SmallGap}" Padding="0,8,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Padding="{StaticResource PanelPadding}">
                            <TextBlock Text="Activity" FontSize="{StaticResource FontTitle}" FontWeight="SemiBold" />
                            <TextBlock x:Name="ActiveCountText" HorizontalAlignment="Right" VerticalAlignment="Center"
                                       FontSize="{StaticResource FontCaption}" FontWeight="SemiBold"
                                       Foreground="{StaticResource AlertBrush}" />
                        </Grid>
                        <!-- Filter: everything, camera events, doors/locks/garage/alarms, or house (automations, SideCar) -->
                        <StackPanel x:Name="ActivityFilters" Grid.Row="1" Orientation="Horizontal" Spacing="4" Padding="8,0,8,0">
                            <Button Tag="all" Content="All" Click="ActivityFilter_Click" FontSize="{StaticResource FontCaption}" MinHeight="{StaticResource ActivityThumbHeight}" />
                            <Button Tag="camera" Content="Cameras" Click="ActivityFilter_Click" FontSize="{StaticResource FontCaption}" MinHeight="{StaticResource ActivityThumbHeight}" />
                            <Button Tag="door" Content="Doors" Click="ActivityFilter_Click" FontSize="{StaticResource FontCaption}" MinHeight="{StaticResource ActivityThumbHeight}" />
                            <Button Tag="house" Content="House" Click="ActivityFilter_Click" FontSize="{StaticResource FontCaption}" MinHeight="{StaticResource ActivityThumbHeight}" />
                            <Button Tag="system" Content="System" Click="ActivityFilter_Click" FontSize="{StaticResource FontCaption}" MinHeight="{StaticResource ActivityThumbHeight}" />
                        </StackPanel>
                        <ListView x:Name="EventList" Grid.Row="2" SelectionMode="None" IsItemClickEnabled="True"
                                  ItemClick="EventList_ItemClick">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="MinHeight" Value="{StaticResource ActivityRowHeight}" />
                                    <Setter Property="Padding" Value="{StaticResource RowPadding}" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:MotionEvent">
                                    <Grid ColumnSpacing="{StaticResource Gap}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <!-- Picture taken when it happened (latest one) -->
                                        <Image Grid.Column="2" Source="{x:Bind Thumbnail, Mode=OneWay}" Visibility="{x:Bind HasThumbnail, Mode=OneWay}" Stretch="UniformToFill"
                                               Height="{StaticResource ActivityThumbHeight}" Width="{StaticResource ActivityThumbWidth}" />
                                        <FontIcon Glyph="{x:Bind Glyph, Mode=OneWay}" FontSize="{StaticResource FontIcon}"
                                                  VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock FontSize="{StaticResource FontBody}" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis">
                                                <Run Text="{x:Bind Label, Mode=OneWay}" />
                                                <Run Text="&#x00B7;" Foreground="{StaticResource MutedText}" />
                                                <Run Text="{x:Bind CameraName}" />
                                            </TextBlock>
                                            <TextBlock FontSize="{StaticResource FontCaption}" Foreground="{StaticResource MutedText}">
                                                <Run Text="{x:Bind TimeText}" />
                                                <Run Text="&#x00B7;" />
                                                <Run Text="{x:Bind DurationText, Mode=OneWay}" />
                                            </TextBlock>
                                            <TextBlock Text="{x:Bind VerdictText, Mode=OneWay}" FontSize="{StaticResource FontCaption}"
                                                       Foreground="{StaticResource AccentText}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <TextBlock x:Name="NoEventsText" Grid.Row="2" Text="No activity yet"
                                   FontSize="{StaticResource FontCaption}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{StaticResource MutedText}" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- ===================== Weather page (Tempest) ===================== -->
        <Grid x:Name="WeatherPage" Visibility="Collapsed" Background="{StaticResource KioskBackground}"
              Padding="{StaticResource PagePadding}" RowSpacing="{StaticResource Gap}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid ColumnSpacing="{StaticResource Gap}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Click="HomeButton_Click" Height="{StaticResource TouchTarget}" Padding="{StaticResource PanelPadding}"
                        CornerRadius="{StaticResource SmallCorner}" FontSize="{StaticResource FontBody}">
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource Gap}">
                        <FontIcon Glyph="&#xE80F;" FontSize="{StaticResource FontIcon}" />
                        <TextBlock Text="Home" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Weather" FontSize="{StaticResource FontTitle}" FontWeight="SemiBold" />
                    <TextBlock x:Name="WeatherStatusText" Text="Waiting for Tempest broadcast"
                               FontSize="{StaticResource FontCaption}" Foreground="{StaticResource MutedText}" />
                </StackPanel>
                <TextBlock x:Name="WeatherClockText" Grid.Column="2" FontSize="{StaticResource FontTitle}"
                           VerticalAlignment="Center" />
            </Grid>

            <Grid Grid.Row="1" RowSpacing="{StaticResource Gap}" ColumnSpacing="{StaticResource Gap}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="3*" />
                    <RowDefinition Height="2*" />
                </Grid.RowDefinitions>

                <!-- Temperature -->
                <Border Grid.ColumnSpan="2" Background="{StaticResource TileAmber}" Padding="{StaticResource TilePadding}">
                    <Grid>
                        <TextBlock Text="Temperature" FontSize="{StaticResource FontBody}" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="WxTemp" Text="--" FontSize="{StaticResource FontHero}" FontWeight="Light" />
                            <TextBlock x:Name="WxCondition" FontSize="{StaticResource FontTitle}" />
                        </StackPanel>
                        <TextBlock x:Name="WxFeels" FontSize="{StaticResource FontBody}" VerticalAlignment="Bottom" Opacity="0.9" />
                    </Grid>
                </Border>

                <!-- Wind -->
                <Border Grid.Column="2" Grid.ColumnSpan="2" Background="{StaticResource TileTeal}" Padding="{StaticResource TilePadding}">
                    <Grid>
                        <TextBlock Text="Wind" FontSize="{StaticResource FontBody}" />
                        <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Spacing="{StaticResource Gap}">
                            <TextBlock x:Name="WxWind" Text="--" FontSize="{StaticResource FontHero}" FontWeight="Light" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="WxWindUnit" FontSize="{StaticResource FontTitle}" />
                                <TextBlock x:Name="WxWindDir" FontSize="{StaticResource FontTitle}" />
                            </StackPanel>
                            <FontIcon x:Name="WxWindArrow" Glyph="&#xE74A;" FontSize="{StaticResource FontBig}"
                                      VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                <FontIcon.RenderTransform>
                                    <RotateTransform x:Name="WxWindRotate" />
                                </FontIcon.RenderTransform>
                            </FontIcon>
                        </StackPanel>
                        <TextBlock x:Name="WxGust" FontSize="{StaticResource FontBody}" VerticalAlignment="Bottom" Opacity="0.9" />
                    </Grid>
                </Border>

                <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="1" Background="{StaticResource PanelBackground}" Padding="{StaticResource TilePadding}">
                    <Grid>
                        <TextBlock Text="Humidity" FontSize="{StaticResource FontBody}" Foreground="{StaticResource MutedText}" />
                        <TextBlock x:Name="WxHumidity" Text="--" FontSize="{StaticResource FontBig}" VerticalAlignment="Center" />
                        <TextBlock x:Name="WxDew" FontSize="{StaticResource FontCaption}" VerticalAlignment="Bottom" Foreground="{StaticResource MutedText}" TextTrimming="CharacterEllipsis" />
                    </Grid>
                </Border>
                <Border Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="1" Background="{StaticResource PanelBackground}" Padding="{StaticResource TilePadding}">
                    <Grid>
                        <TextBlock Text="Rain today" FontSize="{StaticResource FontBody}" Foreground="{StaticResource MutedText}" />
                        <TextBlock x:Name="WxRain" Text="--" FontSize="{StaticResource FontBig}" VerticalAlignment="Center" />
                        <TextBlock x:Name="WxRainDetail" FontSize="{StaticResource FontCaption}" VerticalAlignment="Bottom" Foreground="{StaticResource MutedText}" TextTrimming="CharacterEllipsis" />
                    </Grid>
                </Border>
                <Border Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="1" Background="{StaticResource PanelBackground}" Padding="{StaticResource TilePadding}">
                    <Grid>
                        <TextBlock Text="Pressure" FontSize="{StaticResource FontBody}" Foreground="{StaticResource MutedText}" />
                        <TextBlock x:Name="WxPressure" Text="--" FontSize="{StaticResource FontBig}" VerticalAlignment="Center" />
                        <TextBlock x:Name="WxPressureTrend" FontSize="{StaticResource FontCaption}" VerticalAlignment="Bottom" Foreground="{StaticResource MutedText}" TextTrimming="CharacterEllipsis" />
                    </Grid>
                </Border>
                <Border Grid.Row="1" Grid.Column="3" Grid.ColumnSpan="1" Background="{StaticResource PanelBackground}" Padding="{StaticResource TilePadding}">
                    <Grid>
                        <TextBlock Text="Lightning today" FontSize="{StaticResource FontBody}" Foreground="{StaticResource MutedText}" />
                        <TextBlock x:Name="WxStrikes" Text="--" FontSize="{StaticResource FontBig}" VerticalAlignment="Center" />
                        <TextBlock x:Name="WxStrikeDetail" FontSize="{StaticResource FontCaption}" VerticalAlignment="Bottom" Foreground="{StaticResource MutedText}" TextTrimming="CharacterEllipsis" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- ===================== Home page (live tiles) ===================== -->
        <Grid x:Name="HomePage" Background="{StaticResource KioskBackground}" Padding="{StaticResource PagePadding}"
              RowSpacing="{StaticResource Gap}" ColumnSpacing="{StaticResource Gap}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Shown when the decision model (or a burst limit) paused Home Assistant control. Only you can resume. -->
            <Border x:Name="HomePausedBanner" Grid.ColumnSpan="4" Grid.RowSpan="2" Canvas.ZIndex="10" Visibility="Collapsed"
                    VerticalAlignment="Top" Background="{StaticResource AlertBrush}" Padding="{StaticResource RowPadding}">
                <Grid ColumnSpacing="{StaticResource Gap}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="HomePausedText" FontSize="{StaticResource FontBody}" FontWeight="SemiBold"
                               TextWrapping="Wrap" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Content="Resume" Click="ResumeHome_Click" FontSize="{StaticResource FontBody}"
                            MinHeight="{StaticResource ActivityRowHeight}" Padding="{StaticResource RowPadding}" />
                </Grid>
            </Border>

            <!-- Clock + next meeting (turns amber 15 minutes before) -->
            <Border x:Name="ClockTile" Background="{StaticResource PanelBackground}" Padding="{StaticResource TilePadding}"
                    Tapped="ClockTile_Tapped" AutomationProperties.Name="Calendar">
                <Grid>
                    <StackPanel VerticalAlignment="Top">
                        <TextBlock x:Name="NextMeetingWhen" FontSize="{StaticResource FontCaption}" Foreground="{StaticResource MutedText}" />
                        <TextBlock x:Name="NextMeetingText" FontSize="{StaticResource FontBody}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <TextBlock x:Name="HomeClockText" FontSize="{StaticResource FontTileIcon}" FontWeight="Light"
                               VerticalAlignment="Center" />
                    <TextBlock x:Name="HomeDateText" FontSize="{StaticResource FontBody}" VerticalAlignment="Bottom"
                               Foreground="{StaticResource MutedText}" />
                </Grid>
            </Border>

            <!-- House (Home Assistant, live) -->
            <Button x:Name="HouseTile" Grid.Column="1" Style="{StaticResource MetroTile}"
                    Background="{StaticResource TileTeal}" Padding="{StaticResource TilePadding}"
                    Click="HouseTile_Click" AutomationProperties.Name="House">
                <Grid>
                    <FontIcon Glyph="&#xE80F;" FontSize="{StaticResource FontTileIcon}"
                              HorizontalAlignment="Left" VerticalAlignment="Top" />
                    <TextBlock x:Name="HouseTileValue" Text="--" FontSize="{StaticResource FontTileValue}"
                               HorizontalAlignment="Right" VerticalAlignment="Top" />
                    <StackPanel VerticalAlignment="Bottom">
                        <TextBlock x:Name="HouseTileDetail" Text="Home Assistant" FontSize="{StaticResource FontCaption}"
                                   Opacity="0.85" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="House" FontSize="{StaticResource FontBody}" />
                    </StackPanel>
                </Grid>
            </Button>

            <!-- Cameras (live) -->
            <Button Grid.Column="2" Style="{StaticResource MetroTile}"
                    Background="{StaticResource TileCobalt}" Padding="{StaticResource TilePadding}"
                    Click="CamerasTile_Click" AutomationProperties.Name="Cameras">
                <Grid>
                    <FontIcon Glyph="&#xE714;" FontSize="{StaticResource FontTileIcon}"
                              HorizontalAlignment="Left" VerticalAlignment="Top" />
                    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top">
                        <TextBlock x:Name="CamerasTileValue" FontSize="{StaticResource FontTileValue}"
                                   HorizontalAlignment="Right" />
                        <TextBlock x:Name="CamerasTileDetail" FontSize="{StaticResource FontCaption}"
                                   HorizontalAlignment="Right" Opacity="0.85" />
                    </StackPanel>
                    <TextBlock Text="Cameras" FontSize="{StaticResource FontBody}" VerticalAlignment="Bottom" />
                </Grid>
            </Button>

            <!-- LinkedIn (signal from your feed, read daily) -->
            <Button x:Name="LinkedInTile" Grid.Column="3" Style="{StaticResource MetroTile}"
                    Background="{StaticResource TileSky}" Padding="{StaticResource TilePadding}"
                    Click="LinkedInTile_Click" AutomationProperties.Name="LinkedIn">
                <Grid>
                    <FontIcon Glyph="&#xE716;" FontSize="{StaticResource FontTileIcon}"
                              HorizontalAlignment="Left" VerticalAlignment="Top" />
                    <TextBlock x:Name="LinkedInTileValue" Text="--" FontSize="{StaticResource FontTileValue}"
                               HorizontalAlignment="Right" VerticalAlignment="Top" />
                    <StackPanel VerticalAlignment="Bottom">
                        <TextBlock x:Name="LinkedInTileDetail" Text="Not read yet" FontSize="{StaticResource FontCaption}"
                                   Opacity="0.85" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="LinkedIn" FontSize="{StaticResource FontBody}" />
                    </StackPanel>
                </Grid>
            </Button>

            <!-- Activity (live) -->
            <Button x:Name="ActivityTile" Grid.Row="1" Style="{StaticResource MetroTile}"
                    Background="{StaticResource TileCrimson}" Padding="{StaticResource TilePadding}"
                    Click="ActivityTile_Click" AutomationProperties.Name="Activity">
                <Grid>
                    <FontIcon Glyph="&#xEA8F;" FontSize="{StaticResource FontTileIcon}"
                              HorizontalAlignment="Left" VerticalAlignment="Top" />
                    <TextBlock x:Name="ActivityTileValue" Text="0" FontSize="{StaticResource FontTileValue}"
                               HorizontalAlignment="Right" VerticalAlignment="Top" />
                    <StackPanel VerticalAlignment="Bottom">
                        <TextBlock x:Name="ActivityTileDetail" FontSize="{StaticResource FontCaption}" Opacity="0.85"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="Activity" FontSize="{StaticResource FontBody}" />
                    </StackPanel>
                </Grid>
            </Button>

            <!-- Weather (live, Tempest) -->
            <Button Grid.Row="1" Grid.Column="1" Style="{StaticResource MetroTile}"
                    Background="{StaticResource TileAmber}" Padding="{StaticResource TilePadding}"
                    Click="WeatherTile_Click" AutomationProperties.Name="Weather">
                <Grid>
                    <FontIcon Glyph="&#xE9CA;" FontSize="{StaticResource FontTileIcon}"
                              HorizontalAlignment="Left" VerticalAlignment="Top" />
                    <TextBlock x:Name="WeatherTileValue" Text="--" FontSize="{StaticResource FontTileValue}"
                               HorizontalAlignment="Right" VerticalAlignment="Top" />
                    <StackPanel VerticalAlignment="Bottom">
                        <TextBlock x:Name="WeatherTileDetail" Text="Waiting for Tempest" FontSize="{StaticResource FontCaption}"
                                   Opacity="0.85" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="Weather" FontSize="{StaticResource FontBody}" />
                    </StackPanel>
                </Grid>
            </Button>

            <!-- To-do (live) -->
            <Button x:Name="TasksTile" Grid.Row="1" Grid.Column="2" Style="{StaticResource MetroTile}"
                    Background="{StaticResource TileEmerald}" Padding="{StaticResource TilePadding}"
                    Click="TasksTile_Click" AutomationProperties.Name="To-do">
                <Grid>
                    <FontIcon Glyph="&#xE9D5;" FontSize="{StaticResource FontTileIcon}"
                              HorizontalAlignment="Left" VerticalAlignment="Top" />
                    <TextBlock x:Name="TasksTileValue" Text="0" FontSize="{StaticResource FontTileValue}"
                               HorizontalAlignment="Right" VerticalAlignment="Top" />
                    <StackPanel VerticalAlignment="Bottom">
                        <TextBlock x:Name="TasksTileDetail" Text="Nothing for today" FontSize="{StaticResource FontCaption}"
                                   Opacity="0.85" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="To-do" FontSize="{StaticResource FontBody}" />
                    </StackPanel>
                </Grid>
            </Button>

            <!-- Settings -->
            <Button Grid.Row="1" Grid.Column="3" Style="{StaticResource MetroTile}"
                    Background="{StaticResource TileSteel}" Padding="{StaticResource TilePadding}"
                    AutomationProperties.Name="Settings">
                <Grid>
                    <FontIcon Glyph="&#xE713;" FontSize="{StaticResource FontTileIcon}"
                              HorizontalAlignment="Left" VerticalAlignment="Top" />
                    <TextBlock Text="Settings" FontSize="{StaticResource FontBody}" VerticalAlignment="Bottom" />
                </Grid>
                <Button.Flyout>
                    <Flyout x:Name="MenuFlyout" Placement="Top">
                        <StackPanel Spacing="{StaticResource Gap}">
                            <Button Click="FullScreenButton_Click"
                                    Width="{StaticResource MenuButtonWidth}" Height="{StaticResource TouchTarget}"
                                    FontSize="{StaticResource FontBody}" HorizontalContentAlignment="Left">
                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource Gap}">
                                    <FontIcon Glyph="&#xE740;" FontSize="{StaticResource FontIcon}" />
                                    <TextBlock x:Name="FullScreenButtonText" Text="Exit full screen" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Click="PairPhone_Click"
                                    Width="{StaticResource MenuButtonWidth}" Height="{StaticResource TouchTarget}"
                                    FontSize="{StaticResource FontBody}" HorizontalContentAlignment="Left">
                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource Gap}">
                                    <FontIcon Glyph="&#xE8EA;" FontSize="{StaticResource FontIcon}" />
                                    <TextBlock Text="Pair phone" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Click="QuitButton_Click"
                                    Width="{StaticResource MenuButtonWidth}" Height="{StaticResource TouchTarget}"
                                    FontSize="{StaticResource FontBody}" HorizontalContentAlignment="Left">
                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource Gap}">
                                    <FontIcon Glyph="&#xE711;" FontSize="{StaticResource FontIcon}" />
                                    <TextBlock Text="Quit" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
            </Button>
        </Grid>

        <!-- ===================== To-do ===================== -->
        <controls:TasksPage x:Name="TasksPageView" Visibility="Collapsed" />
        <controls:HomeControlPage x:Name="HouseView" Visibility="Collapsed" />
        <controls:ActivityPage x:Name="ActivityView" Visibility="Collapsed" />
        <controls:LinkedInPage x:Name="LinkedInView" Visibility="Collapsed" />
        <controls:CalendarPage x:Name="CalendarView" Visibility="Collapsed" />

        <!-- ===================== Pair phone (QR code) ===================== -->
        <Grid x:Name="PairingPage" Visibility="Collapsed" Background="{StaticResource KioskBackground}"
              Padding="{StaticResource PagePadding}" ColumnSpacing="{StaticResource Gap}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Background="White" Padding="{StaticResource PanelPadding}" CornerRadius="{StaticResource Corner}"
                    VerticalAlignment="Center">
                <Image x:Name="PairingQr" Stretch="Uniform" Width="{StaticResource QrSize}" Height="{StaticResource QrSize}" />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="{StaticResource Gap}">
                <TextBlock Text="Pair your phone" FontSize="{StaticResource FontTitle}" FontWeight="SemiBold" />
                <TextBlock TextWrapping="Wrap" FontSize="{StaticResource FontBody}" Foreground="{StaticResource MutedText}"
                           Text="Open the SideCar app on your phone and scan this code. It works on your home Wi-Fi." />
                <TextBlock x:Name="PairingUrl" FontSize="{StaticResource FontCaption}" Foreground="{StaticResource MutedText}"
                           TextWrapping="Wrap" />
                <Button Click="ResetPairing_Click" Height="{StaticResource TouchTarget}" Padding="{StaticResource PanelPadding}"
                        CornerRadius="{StaticResource SmallCorner}" FontSize="{StaticResource FontBody}">
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource Gap}">
                        <FontIcon Glyph="&#xE72C;" FontSize="{StaticResource FontIcon}" />
                        <TextBlock Text="New code (unpairs old phones)" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Click="ClosePairing_Click" Height="{StaticResource TouchTarget}" Padding="{StaticResource PanelPadding}"
                        CornerRadius="{StaticResource SmallCorner}" FontSize="{StaticResource FontBody}"
                        Background="{StaticResource TileCobalt}" Foreground="White">
                    <TextBlock Text="Done" VerticalAlignment="Center" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- Camera event popup: shown for 30 s when the kiosk is idle; tap outside or Dismiss to close -->
        <Grid x:Name="EventPopup" Visibility="Collapsed" Background="#B3000000" Tapped="EventPopupScrim_Tapped">
            <Border x:Name="EventPopupCard" MaxWidth="1400" Margin="{StaticResource PagePadding}" VerticalAlignment="Center"
                    Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1"
                    CornerRadius="{StaticResource Corner}" Padding="{StaticResource PanelPadding}" Tapped="EventPopupCard_Tapped">
                <Grid RowSpacing="{StaticResource Gap}" ColumnSpacing="{StaticResource Gap}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="EventPopupTitle" FontSize="{StaticResource FontTitle}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock x:Name="EventPopupWhen" FontSize="{StaticResource FontBody}" Foreground="{StaticResource MutedText}" />
                    </StackPanel>
                    <Image x:Name="EventPopupImage" Grid.Row="1" Stretch="Uniform" MaxHeight="560" />
                    <TextBlock x:Name="EventPopupAi" Grid.Row="2" FontSize="{StaticResource FontBody}" Foreground="{StaticResource AccentText}" TextWrapping="Wrap" />
                    <Grid Grid.Row="3" ColumnSpacing="{StaticResource Gap}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="EventPopupAction" Click="EventPopupLive_Click" FontSize="{StaticResource FontBody}" Height="{StaticResource TouchTarget}"
                                Padding="{StaticResource PanelPadding}" Background="{StaticResource TileCobalt}" Foreground="White"
                                CornerRadius="{StaticResource SmallCorner}">
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource Gap}">
                                <FontIcon x:Name="EventPopupActionIcon" Glyph="&#xE714;" FontSize="{StaticResource FontIcon}" />
                                <TextBlock x:Name="EventPopupActionText" Text="Watch live" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <ProgressBar x:Name="EventPopupCountdown" Grid.Column="1" Maximum="30" VerticalAlignment="Center" Margin="12,0" />
                        <Button Grid.Column="2" Content="Dismiss" Click="EventPopupDismiss_Click" FontSize="{StaticResource FontBody}"
                                Height="{StaticResource TouchTarget}" Padding="{StaticResource PanelPadding}" CornerRadius="{StaticResource SmallCorner}" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Due reminders: stays over every page until you act (Done, Snooze, To-do) -->
        <Border x:Name="ReminderBar" Visibility="Collapsed" VerticalAlignment="Top" Margin="{StaticResource PagePadding}"
                Background="{StaticResource TileAmber}" CornerRadius="{StaticResource Corner}" Padding="{StaticResource PanelPadding}">
            <Grid ColumnSpacing="{StaticResource Gap}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xEA8F;" FontSize="{StaticResource FontTileIcon}" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="ReminderText" FontSize="{StaticResource FontTitle}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock x:Name="ReminderWhen" FontSize="{StaticResource FontCaption}" Opacity="0.85" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="{StaticResource SmallGap}" VerticalAlignment="Center">
                    <Button Content="Done" Tag="done" Click="Reminder_Click" FontSize="{StaticResource FontBody}" Background="{StaticResource TileEmerald}" Foreground="White"
                            Height="{StaticResource TouchTarget}" Padding="{StaticResource PanelPadding}" CornerRadius="{StaticResource SmallCorner}" />
                    <Button Content="10 min" Tag="10" Click="Reminder_Click" FontSize="{StaticResource FontBody}"
                            Height="{StaticResource TouchTarget}" Padding="{StaticResource PanelPadding}" CornerRadius="{StaticResource SmallCorner}" />
                    <Button Content="1 hour" Tag="60" Click="Reminder_Click" FontSize="{StaticResource FontBody}"
                            Height="{StaticResource TouchTarget}" Padding="{StaticResource PanelPadding}" CornerRadius="{StaticResource SmallCorner}" />
                    <Button Content="Tomorrow" Tag="-1" Click="Reminder_Click" FontSize="{StaticResource FontBody}"
                            Height="{StaticResource TouchTarget}" Padding="{StaticResource PanelPadding}" CornerRadius="{StaticResource SmallCorner}" />
                    <Button Content="To-do" Tag="todo" Click="Reminder_Click" FontSize="{StaticResource FontBody}" Background="{StaticResource TileCobalt}" Foreground="White"
                            Height="{StaticResource TouchTarget}" Padding="{StaticResource PanelPadding}" CornerRadius="{StaticResource SmallCorner}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Morning / evening brief: stays until dismissed -->
        <Grid x:Name="BriefPopup" Visibility="Collapsed" Background="#CC000000">
            <Border MaxWidth="1500" Margin="{StaticResource PagePadding}" VerticalAlignment="Center"
                    Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource TileAmber}" BorderThickness="2"
                    CornerRadius="{StaticResource Corner}" Padding="{StaticResource PanelPadding}">
                <Grid RowSpacing="{StaticResource Gap}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="BriefTitle" FontSize="{StaticResource FontTitle}" FontWeight="SemiBold" />
                    <ScrollViewer Grid.Row="1" MaxHeight="760">
                        <TextBlock x:Name="BriefText" FontSize="{StaticResource FontBody}" TextWrapping="Wrap" LineHeight="40" />
                    </ScrollViewer>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="{StaticResource Gap}" HorizontalAlignment="Right">
                        <Button x:Name="BriefPlay" Click="BriefPlay_Click" FontSize="{StaticResource FontBody}" Background="{StaticResource TileCobalt}"
                                Foreground="White" Height="{StaticResource TouchTarget}" Padding="{StaticResource PanelPadding}" CornerRadius="{StaticResource SmallCorner}">
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource Gap}">
                                <FontIcon x:Name="BriefPlayIcon" Glyph="&#xE768;" FontSize="{StaticResource FontIcon}" />
                                <TextBlock x:Name="BriefPlayText" Text="Play" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="BriefRemake" Content="Make it now" Click="BriefRemake_Click" FontSize="{StaticResource FontBody}"
                                Height="{StaticResource TouchTarget}" Padding="{StaticResource PanelPadding}" CornerRadius="{StaticResource SmallCorner}" />
                        <Button Content="Dismiss" Click="BriefDismiss_Click" FontSize="{StaticResource FontBody}" Background="{StaticResource TileAmber}"
                                Height="{StaticResource TouchTarget}" Padding="{StaticResource PanelPadding}" CornerRadius="{StaticResource SmallCorner}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Voice assistant: floating mic button (lower right) over every page -->
        <controls:AssistantOverlay x:Name="Assistant" />
    </Grid>
</Window>
